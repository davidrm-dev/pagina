---
import '../styles/global.css'
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>Aromas Quirences - Desde Zetaquira, Boyacá</title>
    <meta name="description" content="Del campo boyacense a tu mesa. Pulpa de fruta, jugos naturales y congelados IQF con el aroma único de nuestra tierra. Calidad de exportación directamente desde Zetaquira." />
    <meta name="theme-color" content="#0d4d2a" />

    <!-- Preconnect Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Lato:ital,wght@0,100;0,300;0,400;0,700;0,900;1,400&display=swap" rel="stylesheet" />

    <!-- Open Graph -->
    <meta property="og:title" content="Aromas Quirences - Desde Zetaquira, Boyacá" />
    <meta property="og:description" content="Del campo boyacense a tu mesa. Pulpa de fruta, jugos naturales y congelados IQF con el aroma único de nuestra tierra." />
    <meta property="og:type" content="website" />
    <meta property="og:image" content="/logo.png" />

    <!-- Favicon -->
    <link rel="icon" href="/logo.png" />
  </head>
  <body class="font-lato">
    <slot />
  </body>
</html>
